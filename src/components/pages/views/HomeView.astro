 <!-- CTA — full-bleed navy band (see CtaBeamBand.astro), same on every
      viewport. Butts directly against the footer below with zero gap —
      no section padding, no border — so the two read as one continuous
      dark surface, matching the reference site. -->
  <CtaBeamBand>
    <h2 class="text-4xl font-bold mb-4 text-balance">
      {cta.heading}
    </h2>
    <p class="text-lg mb-8 text-balance">
      {cta.description}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button size="lg" href={contactUrl}>
        {cta.primary}
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href={aboutUrl}>
        {cta.secondary}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </CtaBeamBand>

<style is:global>
  /* The hero paragraph is short by design (one sentence, ~28 words) — cap it
     narrower than Hero.astro's own max-w-xl default (36rem) so it reads as a
     tight, confident sentence rather than stretching to fill the wider
     split-layout text column. Scoped via the unique .hero-dark-gradient
     class so other heroes keep the default measure. */
  @media (min-width: 768px) {
    .hero-dark-gradient .hero-title-slot + div {
      max-width: 30rem;
    }
  }

  /* Spacious vertical rhythm pass: badge → headline → paragraph → CTAs each
     get more room than Hero.astro's shared defaults, so the hero reads as
     calm and premium rather than a tightly-packed stack. Unlayered, so it
     beats the `mb-[var(--space-heading-gap)]` etc. Tailwind arbitrary-value
     utilities already on these elements (Tailwind's generated utilities
     always live inside `@layer utilities`, which loses to any unlayered
     rule of the same importance regardless of specificity). */
  .hero-dark-gradient .hero-badge-slot {
    margin-bottom: var(--space-7);
  }
  .hero-dark-gradient .hero-title-slot {
    margin-bottom: var(--space-8);
  }
  .hero-dark-gradient .hero-description-slot {
    margin-bottom: var(--space-10);
  }

  /* Split layout's default is an even 50/50 column split (shared with the
     /components kitchen-sink demos, which DO put content in the second
     column) — too narrow here, where the second column is empty (the photo
     is a background layer, not grid content) and the four-up highlight row
     needs real room to stay on one line. Scoped to this hero only so the
     shared default stays untouched everywhere else it's used. */
  @media (min-width: 1024px) {
    .hero-dark-gradient .grid.max-w-6xl {
      grid-template-columns: 3fr 2fr;
    }
  }

  /* Four-up "what we deliver" row beneath the hero CTAs. Accent-coloured
     icon, muted label — secondary to the H1/description, same hierarchy
     the description text uses. */
  .hp-hero-highlight-icon {
    color: var(--color-brand-400);
  }

  /* Primary hero CTA — filled in the brand colour instead of the site's
     default near-white pill. The default reads fine on a flat dark gradient,
     but sitting on a photo (much of it already light/warm in tone) it lost
     contrast and didn't read as "the button to press". Brand-orange fill
     matches IRFATECH's own on-wall branding in the photo, so it also ties
     the CTA back into the shot rather than competing with it. This covers
     dark mode (the site default — no competing override there); the
     light-mode equivalent lives in global.css's `.hero-dark-gradient
     .btn-primary` block instead, since author `!important` inside
     Tailwind's `@layer utilities` beats author `!important` outside any
     layer regardless of specificity, and that light-mode override is
     declared inside the layer. */
  .hero-dark-gradient .hp-hero-cta-primary.btn-primary {
    background-color: var(--color-brand-500) !important;
    background-image: none !important;
    color: white !important;
    border-color: transparent !important;
    box-shadow: 0 8px 24px -8px color-mix(in oklch, var(--color-brand-600) 60%, transparent);
  }
  .hero-dark-gradient .hp-hero-cta-primary.btn-primary:hover {
    background-color: var(--color-brand-600) !important;
  }

  /* Small uppercase trust label sitting above the industries strip — gives the
     row (now logos of INDUSTRIES we serve, not tools we build) the context a
     bare row of icons + labels wouldn't carry on its own. Left-aligned (not
     centred) and given its own top border so it reads as a distinct "trust
     bar" opening a new beat, consistent with the left-aligned content above
     it rather than the centred treatment a `layout="centered"` hero would use. */
  .hp-hero-industries-label {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    margin-bottom: var(--space-3);
    max-width: 72rem;
    border-top: 1px solid color-mix(in oklch, white 12%, transparent);
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-subtle);
    opacity: 0.85;
  }
  @media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
    .hp-hero-industries-label { display: none; }
  }

  /* ── Homepage hero industries marquee ────────────────────────────────────
     A decorative industries-served strip floored into the hero in place of the
     scroll indicator. It must stay secondary to the H1 / description / CTAs, so we
     strip the card "box" (brand border, glow ring, panel surface) and let the
     brand-coloured logos float on the hero gradient as light accents. The logos
     keep their brand colour and soft chip; only the surrounding chrome is removed. */
  .hp-hero-marquee .stack-marquee-item > * {
    background: transparent;   /* drop the card panel */
    border-color: transparent; /* drop the brand border */
    box-shadow: none;          /* drop the brand glow ring */
    padding-left: var(--space-3);  /* tighter now there's no box, so logos sit closer */
    padding-right: var(--space-3);
  }
  /* Lighter, calmer tool names so the colourful logos lead the eye. */
  .hp-hero-marquee .stack-marquee-item .font-display {
    font-weight: 500;
    color: var(--color-foreground-muted);
  }

  /* Floored into the hero: the marquee is the section's last flex child, pushed to
     the floor (mt-auto, in Hero.astro). The CONTENT stays at the top and the
     leftover hero height opens up BETWEEN the CTAs and the marquee — the roomy
     "Chrome look". The section's column `gap` (--hero-floor-gap) is a GUARANTEED
     MINIMUM gap, so on shorter windows the marquee can never crowd the buttons;
     taller windows simply get more room. padding-bottom is the breathing room
     beneath it. */
  section.hero-dark-gradient {
    --hero-floor-gap: var(--space-16); /* 4rem — minimum gap above the marquee */
    padding-bottom: var(--space-16); /* 4rem — breathing room below it */
  }
  .hp-hero-marquee {
    pointer-events: none; /* decorative; never intercepts taps */
  }

  /* Entrance: the marquee sits outside the content stagger container, so it fades
     in on its own once the hero has settled (a vertical slide would fight the
     logos' horizontal scroll). */
  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-marquee {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
  @keyframes hp-hero-marquee-fade {
    from { opacity: 0.01; }
    to   { opacity: 1; }
  }

  /* Hidden on phones — portrait (width) and landscape (short + coarse pointer),
     matching the tech-stack section's behaviour. Shown from tablet up. */
  @media (max-width: 767px) {
    .hp-hero-marquee { display: none; }
  }
  @media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
    .hp-hero-marquee { display: none; }
  }

  /* Portrait-phone static industry pills — the lightweight counterpart to the
     marquee. Hidden by default and shown only on portrait phones, exactly where
     the marquee is hidden. A centered, non-interactive, wrapping row: no links
     and no animation loop, so it costs nothing after paint. Wraps to two rows
     rather than a single row of bare logo circles — industry labels
     ("Retail & Wholesale") don't fit four across on a phone the way four
     short tool names did. */
  .hp-hero-logos {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    pointer-events: none;
  }
  @media (max-width: 767px) and (orientation: portrait) {
    .hp-hero-logos { display: flex; padding-bottom: 2rem; }
  }

  .hp-hero-logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.75rem;
    border-radius: 9999px;
    color: var(--color-brand-500);
    background: color-mix(in oklch, var(--color-brand-500) 12%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* One-time fade-in only (reuses the marquee's keyframe); nothing loops. */
  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-logos {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }

  /* ── Process steps (cards) ─────────────────────────────────────────────────
     The homepage's four engagement steps as hoverable cards — same visual
     recipe as ProofTile/Card elsewhere on the site (bg-background-tertiary,
     brand-tinted border, shadow-lg, hover:-translate-y-1 + brighter border +
     deeper shadow — those utility classes are on the <li> itself in the
     markup), so a step visibly responds to the cursor instead of sitting
     inert on the page. */
  .process-steps {
    /* width:100% — this <ol> is a direct child of a `flex flex-col`
       container (the section's inner wrapper div), and a flex item with
       `margin-inline: auto` but no explicit width shrinks to fit its own
       content instead of stretching to the container's cross-axis size
       (same bug fixed in Hero.astro's content grid). It currently renders
       full-width only because the step copy is long enough to reach the
       container edge on its own — shorter i18n copy would collapse and
       centre it instead of filling the row. */
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
  }
  /* Icon node: 5rem, noticeably larger than ProofTile's own bare 2.5rem
     icon, since this is the visual anchor of a 4-card row rather than one
     of many small tile icons. The icon carries the step's MEANING (a
     message bubble reads as "get in touch" faster than the numeral "1"
     does); the sequence number moves to a small corner badge instead. */
  .process-step-node {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    flex: none;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-600));
    box-shadow: 0 10px 28px -6px color-mix(in oklch, var(--color-brand-500) 60%, transparent);
    transition: transform 200ms ease;
  }
  .process-step-card:hover .process-step-node {
    transform: scale(1.06);
  }
  .process-step-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-brand-50);
  }
  .process-step-num {
    position: absolute;
    top: -0.125rem;
    right: -0.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 9999px;
    background: var(--color-background-tertiary);
    box-shadow: 0 0 0 3px var(--color-background-tertiary);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-brand-500);
  }
  .process-step-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-foreground);
  }
  /* The one concrete commitment from each step's paragraph, pulled up front
     as its own filled pill — reply time, fixed price, etc. — so the row
     scans in five seconds even for a visitor who never reads the
     paragraphs below. A pill (not plain coloured text) so it reads as a
     small badge of proof, not another line of body copy. */
  .process-step-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 9999px;
    background: color-mix(in oklch, var(--color-brand-500) 15%, transparent);
    padding: 0.3rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand-300);
  }
  .process-step-stat svg {
    flex: none;
    color: var(--color-brand-400);
  }
  /* Foreground-secondary (brighter than the site's default muted-body tier)
     — this card sits on bg-background-tertiary, one step lighter than the
     surrounding section, and the standard muted grey read as low-contrast
     against it. */
  .process-step-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-foreground-secondary);
  }

  /* CTA directly under the last step: the moment a visitor finishes reading
     exactly what happens after they reach out is the moment their perceived
     risk is lowest, so the next action is offered right here rather than
     three sections later. Quieter than the primary hero CTA (text link, not
     a filled button) — this page has one filled-button CTA band already
     coming up; repeating that treatment here would just be visual noise. */
  .process-cta {
    display: flex;
    justify-content: center;
  }
  .process-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
    border-bottom: 1px solid color-mix(in oklch, var(--color-brand-500) 50%, transparent);
    padding-bottom: 0.125rem;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .process-cta-link svg {
    color: var(--color-brand-500);
    transition: transform 150ms ease;
  }
  .process-cta-link:hover {
    color: var(--color-brand-500);
    border-color: var(--color-brand-500);
  }
  .process-cta-link:hover svg {
    transform: translateX(3px);
  }
</style>

</LandingLayout>
