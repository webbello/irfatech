---
import Input from '@/components/ui/form/Input/Input.astro';
import Select from '@/components/ui/form/Select/Select.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { cn } from '@/lib/cn';
import { t, getLocaleFromPath } from '@/i18n';
import { contactConfigured } from '@/lib/email';
import siteConfig from '@/config/site.config';

interface Props {
  action?: string;
  successMessage?: string;
  class?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);

// Which channel actually delivers the message — see the doc comment on
// `contact` in site.config.ts. Swapping this later is a one-line config
// change; everything below just reacts to it.
const channel = siteConfig.contact?.channel ?? 'email';
const whatsappNumber = siteConfig.contact?.whatsappNumber ?? siteConfig.phone;
const isWhatsapp = channel === 'whatsapp';

/**
 * The endpoint returns "Email service is not configured" with a 500 — but only
 * after a visitor has typed a name, an address and a message. Reading the same
 * state at render time lets the form say so before anyone starts writing, and
 * the notice itself is for whoever is building the site, so it shows in dev
 * only. Visitors get a disabled submit and one plain line instead.
 *
 * WhatsApp mode has no server key to be missing — it's "unconfigured" only
 * if there's no number to open a chat with at all.
 */
const unconfigured = isWhatsapp ? !whatsappNumber : !contactConfigured;
const showDevNotice = unconfigured && import.meta.env.DEV;

const {
  action = '/api/contact',
  successMessage = isWhatsapp ? t('contact.whatsappOpening', locale) : t('contact.success', locale),
  class: className,
} = Astro.props;
---

<form
  id="contact-form"
  action={action}
  method="POST"
  class={cn('space-y-6', className)}
  data-success-message={successMessage}
  data-sending={t('contact.sending', locale)}
  data-generic-error={t('contact.genericError', locale)}
  data-error-message={t('contact.error', locale)}
  data-channel={channel}
  data-whatsapp-number={isWhatsapp ? whatsappNumber : undefined}
>
  <!-- Name + Email side by side on sm+ -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <Input
      label={t('contact.name', locale)}
      name="name"
      type="text"
      required
      autocomplete="name"
    />
    <Input
      label={t('contact.email', locale)}
      name="email"
      type="email"
      required={!isWhatsapp}
      autocomplete="email"
    />
  </div>

  <!-- Optional: pre-qualifies the inquiry so a reply can start from the
       right context instead of a first round of "what do you need?" -->
  <Select
    label={t('contact.service', locale)}
    name="service"
    placeholder={t('contact.servicePlaceholder', locale)}
    options={[
      { value: 'business-systems', label: t('contact.serviceBusinessSystems', locale) },
      { value: 'automation', label: t('contact.serviceAutomation', locale) },
      { value: 'presence', label: t('contact.servicePresence', locale) },
      { value: 'other', label: t('contact.serviceOther', locale) },
    ]}
  />

  <Textarea
    label={t('contact.message', locale)}
    name="message"
    required
    rows={5}
  />

  <!-- Honeypot field for spam protection -->
  <div class="hidden" aria-hidden="true">
    <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
  </div>

  <div id="form-message" class="hidden text-sm"></div>

  {showDevNotice && (
    <p class="text-center text-xs text-foreground-subtle text-balance">
      {t('contact.notConfigured', locale)}
    </p>
  )}

  {unconfigured && !import.meta.env.DEV && (
    <p class="text-center text-xs text-foreground-subtle text-balance">
      {t('contact.unavailable', locale)}
    </p>
  )}

  <div class="flex justify-center">
    <Button
      type="submit"
      id="submit-button"
      disabled={unconfigured && !import.meta.env.DEV}
      class="gap-2 cta-btn-brand"
    >
      {isWhatsapp ? t('contact.sendWhatsapp', locale) : t('contact.send', locale)}
      <Icon name={isWhatsapp ? 'brand-whatsapp' : 'arrow-right'} size="sm" />
    </Button>
  </div>
</form>

<script>
  import { buildWhatsAppUrl } from '@/lib/contact-channel';

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const button = document.getElementById('submit-button') as HTMLButtonElement;
    const message = document.getElementById('form-message') as HTMLDivElement;

    if (!form || !button || !message) return;

    const successMessage = form.dataset.successMessage || 'Message sent successfully!';
    const originalButtonHTML = button.innerHTML;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);

      // WhatsApp is a pure client-side hand-off — no server round-trip, so
      // no fetch, no honeypot check (a bot can't make a human press send in
      // their own WhatsApp app, which is the point).
      if (form.dataset.channel === 'whatsapp') {
        const number = form.dataset.whatsappNumber;
        if (!number) return;

        const url = buildWhatsAppUrl(number, {
          name: formData.get('name')?.toString() || '',
          email: formData.get('email')?.toString() || '',
          subject: formData.get('subject')?.toString() || undefined,
          service: formData.get('service')?.toString() || undefined,
          message: formData.get('message')?.toString() || '',
        });

        window.open(url, '_blank', 'noopener');
        message.textContent = successMessage;
        message.className = 'text-sm text-success-strong';
        message.classList.remove('hidden');
        form.reset();
        return;
      }

      button.disabled = true;
      button.textContent = form.dataset.sending || 'Sending…';
      message.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          message.textContent = successMessage;
          message.className = 'text-sm text-success-strong';
          form.reset();
        } else {
          const errors = data.errors
            ? Object.values(data.errors).flat().join(', ')
            : (form.dataset.genericError || 'Something went wrong');
          message.textContent = errors as string;
          message.className = 'text-sm text-destructive';
        }
      } catch {
        message.textContent = form.dataset.errorMessage || 'Failed to send message. Please try again.';
        message.className = 'text-sm text-destructive';
      } finally {
        button.disabled = false;
        button.innerHTML = originalButtonHTML;
        message.classList.remove('hidden');
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
