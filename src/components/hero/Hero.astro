---
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { cn } from '@/lib/cn';
import { heroSectionVariants } from './hero.variants';
import HeroGrid from '@/components/effects/HeroGrid.astro';
import HeroBeam from '@/components/effects/HeroBeam.astro';

interface Props extends HTMLAttributes<'section'> {
  /** Layout mode: centered single column or split two-column */
  layout?: 'centered' | 'split';
  /** Vertical padding size */
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Show background grid pattern */
  showGrid?: boolean;
  /** Show brand-coloured radial glow blobs behind the content */
  showGlow?: boolean;
  /** Show decorative gradient blob */
  showBlob?: boolean;
  /** Render the light-mode architectural grid + dark-mode halo behind the hero */
  showHeroHalo?: boolean;
  /**
   * Dot-grid + brand-glow texture, parallaxing on desktop. A signature texture
   * introduced with the landing diagram sections, so the hero shares it instead
   * of reading flat by comparison. Independent of
   * `showGrid`/`showGlow` (those are gated to the site's dark *mode*; this
   * is meant for `hero-dark-gradient`-style panels that are always dark
   * regardless of site mode, so it isn't mode-gated).
   */
  showDotGrid?: boolean;
  /**
   * Background photo texture behind the content — dimmed, grayscaled and
   * vignetted so it reads as depth, not imagery, and never competes with
   * the headline. Same recipe as the landing diagram panels' photo
   * treatment: a small static image
   * on mobile, a larger one with desktop-only fixed-attachment parallax
   * (iOS Safari doesn't honour fixed attachment, so mobile stays static),
   * all skipped under prefers-reduced-motion. Pass an asset import, e.g.
   * `bgImage={networkPhoto}`.
   */
  bgImage?: ImageMetadata;
  /**
   * Opacity of the background photo layer (0–1). Default 0.35 is tuned for a
   * texture-like backdrop that stays out of the way of the headline. A hero
   * where the photo IS the subject (e.g. a portrait/office shot with its own
   * empty space for copy) wants this much higher — close to 1 — so it reads
   * as a real photo rather than a faint, dull tint.
   */
  bgImageOpacity?: number;
  /** CSS `filter` applied to the background photo layer. */
  bgImageFilter?: string;
  /** CSS `background-position` applied to the background photo layer. */
  bgImagePosition?: string;
  /**
   * CSS `background-position` below the `md` breakpoint. `cover` sizing on a
   * narrow, tall viewport crops most of the frame away, so a position tuned
   * for desktop can land on the wrong part of the photo (e.g. an overexposed
   * sky instead of the subject). Falls back to `bgImagePosition` when unset.
   */
  bgImagePositionMobile?: string;
  /**
   * Shape of the `.hero-content-scrim` legibility layer. `center` (default)
   * is a radial pool centred on the text column, for photos with an even or
   * centred subject. `left` is a horizontal fade — strong on the left where
   * the copy sits, clear by mid-width — for photos with the subject/detail
   * composed toward the right and empty space on the left for copy.
   */
  scrimVariant?: 'center' | 'left';
  /** Blob position (only applies when showBlob is true) */
  blobPosition?: 'left' | 'right' | 'center';
  /** Fade the bottom of the section into the next section's background */
  bottomFade?: boolean;
  /** Show an animated scroll indicator at the bottom (desktop only, hides on scroll) */
  showScrollIndicator?: boolean;
  /** Stretch the section to fill at least the full viewport height (min-h-[100dvh]) */
  fullHeight?: boolean;
}

const {
  layout = 'centered',
  size = 'lg',
  showGrid = false,
  showBlob = false,
  blobPosition: _blobPosition = 'center',
  showGlow = false,
  showHeroHalo = false,
  showDotGrid = false,
  bgImage,
  bgImageOpacity,
  bgImageFilter,
  bgImagePosition,
  bgImagePositionMobile,
  scrimVariant = 'center',
  bottomFade = false,
  showScrollIndicator = false,
  fullHeight = false,
  class: className,
  ...attrs
} = Astro.props;

// Check which slots are provided
const hasBadgeSlot = Astro.slots.has('badge');
const hasTitleSlot = Astro.slots.has('title');
const hasDescriptionSlot = Astro.slots.has('description');
const hasActionsSlot = Astro.slots.has('actions');
const hasAsideSlot = Astro.slots.has('aside');
const hasBottomSlot = Astro.slots.has('bottom');

// Background photo: two sizes — a small static one for mobile (no parallax,
// no need for desktop resolution) and a larger one for the fixed-attachment
// desktop parallax, which needs to cover more than one viewport height as it
// drifts. Same sizing as the landing diagram panels' photo layer. Compiled once into a CSS
// custom-property string so the template just applies it.
let bgPhotoStyle: string | undefined;
if (bgImage) {
  const [mobile, desktop] = await Promise.all([
    getImage({ src: bgImage, width: 900, format: 'webp', quality: 60 }),
    getImage({ src: bgImage, width: 2000, format: 'webp', quality: 68 }),
  ]);
  bgPhotoStyle = `--hero-photo-mobile:url(${mobile.src});--hero-photo-desktop:url(${desktop.src});`;
  if (bgImageOpacity !== undefined) bgPhotoStyle += `--hero-photo-opacity:${bgImageOpacity};`;
  if (bgImageFilter) bgPhotoStyle += `--hero-photo-filter:${bgImageFilter};`;
  if (bgImagePosition) bgPhotoStyle += `--hero-photo-position:${bgImagePosition};`;
  if (bgImagePositionMobile) bgPhotoStyle += `--hero-photo-position-mobile:${bgImagePositionMobile};`;
}

// Compute alignment based on layout
const alignment = layout === 'centered' ? 'text-center items-center' : 'text-left items-start';

// When a bottom slot is used in a full-height hero, lay the section out as a flex
// column so the slot can be pushed to the floor (mt-auto) while the CONTENT stays
// at the top — leftover height then opens up BETWEEN them (the roomy "Chrome
// look"). The column `gap` is a GUARANTEED minimum gap, so the slot never crowds
// the content on short windows. Tunable per hero via --hero-floor-gap (default 4rem).
const isFlooredBottom = fullHeight && hasBottomSlot;

// Compute classes
const sectionClasses = cn(
  heroSectionVariants({ size }),
  // Full-viewport hero: stretch to at least the viewport height. Uses svh (stable
  // small viewport) rather than dvh so the hero does NOT resize as the mobile
  // browser's address bar shows/hides on scroll. No upper cap — a 60rem cap used
  // to cut the hero short on viewports taller than 960px (portrait tablets), so
  // the next section bled into the first screen; the floored bottom slot absorbs
  // extra height by design.
  fullHeight && 'min-h-[100svh]',
  // Floored bottom slot (e.g. the homepage tech-stack marquee): flex column so the
  // slot floats to the floor with a guaranteed minimum gap above it.
  isFlooredBottom && 'flex flex-col gap-[var(--hero-floor-gap,4rem)]',
  className
);

const contentClasses = cn(
  'z-10 flex flex-col',
  alignment
);

const gridClasses = cn(
  // w-full: when isFlooredBottom is true the section becomes a column flex
  // container (see sectionClasses below), and a flex item with `mx-auto`
  // but no explicit width doesn't stretch to fill the cross axis the way a
  // block-level element would — auto margins on a flex item's cross axis
  // absorb all the extra space instead, so the grid shrank to fit its own
  // content and then centred that shrunk box, pushing a left-aligned split
  // hero's text column inward instead of flush with the section's padding.
  // `w-full` restores the block-flow behaviour: fill the line, then let
  // max-w-6xl + mx-auto cap and centre it as intended.
  'relative z-10 mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-[var(--space-section-gap)] px-6',
  layout === 'split' && 'lg:grid-cols-2 lg:gap-[var(--space-section-gap)]',
  // Full-height hero with a floored bottom slot: centre the content in the
  // leftover height (my-auto splits it evenly above and below), so the hero
  // stays balanced on tall windows instead of pooling all spare space
  // between the actions and the bottom slot.
  isFlooredBottom && 'my-auto'
);
---

<section class={sectionClasses} {...attrs}>
  {showHeroHalo && <HeroGrid />}
  {showHeroHalo && <HeroBeam />}
  {bgPhotoStyle && (
    <div
      class={cn('hero-bg-photo', scrimVariant === 'left' && 'hero-bg-photo-full')}
      aria-hidden="true"
      style={bgPhotoStyle}
    />
  )}
  {bgPhotoStyle && <div class={cn('hero-content-scrim', scrimVariant === 'left' && 'hero-content-scrim-left')} aria-hidden="true" />}
  {showDotGrid && <div class="hero-dot-grid" aria-hidden="true" />}

  {showGrid && (
    <div
      class="bg-grid-pattern pointer-events-none absolute inset-x-0 -inset-y-[20%] opacity-30 hidden md:dark:block"
      style="mask-image: radial-gradient(ellipse 50% 50% at 50% 40%, black 0%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 40%, black 0%, transparent 70%);"
      aria-hidden="true"
    />
  )}

  {showGlow && (
    <>
      <div class="pointer-events-none absolute left-1/2 top-1/4 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/15 blur-[120px] hidden dark:block" aria-hidden="true" />
      <div class="pointer-events-none absolute bottom-1/4 right-1/4 h-[400px] w-[400px] rounded-full bg-brand-600/10 blur-[100px] hidden dark:block" aria-hidden="true" />
    </>
  )}

  {showBlob && (
    <>
      <div
        class="pointer-events-none absolute hidden dark:block dark:opacity-[0.20] rounded-full blur-[120px] h-[500px] w-[500px] -left-20 top-0 -translate-y-1/4"
        style="background: radial-gradient(ellipse at center, var(--color-brand-400) 0%, transparent 70%);"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute hidden dark:block dark:opacity-[0.20] rounded-full blur-[120px] h-[500px] w-[500px] -right-20 top-0 -translate-y-1/4"
        style="background: radial-gradient(ellipse at center, var(--color-brand-400) 0%, transparent 70%);"
        aria-hidden="true"
      />
    </>
  )}

  {bottomFade && (
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-background-secondary hidden dark:block" aria-hidden="true" />
  )}


  {showScrollIndicator && (
    <div class="scroll-indicator-wrapper absolute bottom-14 left-1/2 -translate-x-1/2 z-10" aria-hidden="true">
      <div class="scroll-indicator flex flex-col items-center gap-0.5">
        <svg class="scroll-indicator-chevron w-7 h-7 text-brand-500/70" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
        <svg class="scroll-indicator-chevron-2 w-7 h-7 text-brand-500/35" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>
    </div>
  )}

  <div class={gridClasses}>
    {/* Content Column */}
    <div class={cn(contentClasses, 'order-1 lg:order-none animate-hero-stagger')}>
      {/* Badge Slot */}
      {hasBadgeSlot && (
        <div class="hero-badge-slot mb-[var(--space-heading-gap)]">
          <slot name="badge" />
        </div>
      )}

      {/* Title Slot */}
      {hasTitleSlot && (
        <div class={cn(
          'hero-title-slot mb-[var(--space-heading-gap)]',
          '[&>h1]:font-display [&>h1]:text-5xl [&>h1]:leading-[1.1] [&>h1]:font-bold [&>h1]:tracking-tight [&>h1]:text-balance [&>h1]:text-foreground md:[&>h1]:text-6xl lg:[&>h1]:text-7xl',
          '[&>h2]:font-display [&>h2]:text-4xl [&>h2]:leading-[1.1] [&>h2]:font-bold [&>h2]:tracking-tight [&>h2]:text-balance [&>h2]:text-foreground md:[&>h2]:text-5xl lg:[&>h2]:text-6xl'
        )}>
          <slot name="title" />
        </div>
      )}

      {/* Description Slot */}
      {hasDescriptionSlot && (
        <div class={cn(
          'hero-description-slot mb-[var(--space-stack-lg)] max-w-xl text-lg leading-relaxed text-foreground-muted',
          '[&>p]:text-lg [&>p]:leading-relaxed [&>p]:text-foreground-muted',
          layout === 'centered' && 'mx-auto'
        )}>
          <slot name="description" />
        </div>
      )}

      {/* Actions Slot */}
      {hasActionsSlot && (
        <div class={cn(
          'hero-actions-slot flex w-full flex-col gap-4 sm:w-auto sm:flex-row',
          layout === 'centered' && 'justify-center'
        )}>
          <slot name="actions" />
        </div>
      )}

      {/* Default slot for additional content (social proof, etc.) */}
      <slot />
    </div>

    {/* Aside Column (for split layout) */}
    {layout === 'split' && hasAsideSlot && (
      <div class="relative z-10 w-full order-2 lg:order-none">
        <slot name="aside" />
      </div>
    )}
  </div>

  {/* Bottom slot — e.g. the homepage tech-stack marquee, in place of the scroll
      indicator. In a full-height hero it's the last flex child, so it sits on
      the floor while the content grid centres itself in the leftover height
      (my-auto above); the section's column `gap` guarantees a minimum gap so
      the slot never crowds the content on short windows. Outside full-height
      it falls back to absolute. */}
  {hasBottomSlot && (
    <div class={cn(
      'hero-bottom-slot z-10 w-full',
      isFlooredBottom ? 'relative' : 'absolute inset-x-0 bottom-0'
    )}>
      <slot name="bottom" />
    </div>
  )}
</section>

<style>
  /* Dot-grid + brand-glow texture — same recipe as the landing diagram
     panels' dot-grid backdrop, reused here so the hero isn't flat by
     comparison. Sits above the hero's own gradient background but below the
     content (z-0 vs content's z-10). */
  .hero-dot-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 15% 20%, color-mix(in oklch, var(--color-foreground) 14%, transparent) 0%, transparent 40%),
      radial-gradient(circle at 85% 75%, color-mix(in oklch, var(--color-foreground) 10%, transparent) 0%, transparent 38%),
      radial-gradient(color-mix(in oklch, var(--color-foreground) 14%, transparent) 1.5px, transparent 1.5px);
    background-size:
      auto,
      auto,
      28px 28px;
    background-repeat: no-repeat, no-repeat, repeat;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  }
  @media (min-width: 1024px) and (pointer: fine) {
    .hero-dot-grid {
      background-attachment: fixed;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-dot-grid {
      background-attachment: scroll;
    }
  }

  /* Background photo texture. Was fully grayscaled and dimmed to 0.24
     opacity so it read as "depth, not imagery" — in practice that just read
     as a flat, dull haze, especially once the dot-grid (which used to add
     its own texture on top) was removed. Now mostly desaturated but not
     fully, and brighter/more contrasty, so real colour and detail (sky,
     lights, water) show through — the photo is doing real visual work
     instead of a faint tint. Text legibility is handled separately by
     `.hero-content-scrim` below, not by keeping the photo washed out.
     Mobile-first: small static image; swapped for the larger one under the
     desktop parallax query below. */
  .hero-bg-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--hero-photo-mobile);
    background-size: cover;
    background-position: var(--hero-photo-position, center);
    background-repeat: no-repeat;
    opacity: var(--hero-photo-opacity, 0.35);
    filter: var(--hero-photo-filter, grayscale(0.3) contrast(1.15) saturate(1.3) brightness(1.05));
    -webkit-mask-image: radial-gradient(ellipse 95% 85% at 50% 45%, black 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 95% 85% at 50% 45%, black 55%, transparent 100%);
  }
  @media (min-width: 1024px) and (pointer: fine) {
    .hero-bg-photo {
      background-image: var(--hero-photo-desktop);
      background-attachment: fixed;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-photo {
      background-attachment: scroll;
    }
  }

  /* Full-bleed variant: the photo IS the hero image (a portrait/office shot
     composed with its own empty space for copy), not a background texture —
     so it must not fade out at the edges the way the radial mask above does
     for the low-opacity texture photos. Also opts out of the fixed-attachment
     parallax above: at near-full opacity, a section taller than the viewport
     (this variant is used with fullHeight + a bottom slot, which can push the
     section past 100svh) exposed the bare gradient below the fold, since
     `background-attachment: fixed` sizes/positions cover relative to the
     viewport rather than the (taller) section box. Scroll attachment always
     covers the element itself, so this stays full-bleed at any section height. */
  .hero-bg-photo-full {
    -webkit-mask-image: none;
    mask-image: none;
  }
  @media (min-width: 1024px) and (pointer: fine) {
    .hero-bg-photo-full {
      background-attachment: scroll;
    }
  }
  @media (max-width: 767px) {
    .hero-bg-photo-full {
      background-position: var(--hero-photo-position-mobile, var(--hero-photo-position, center));
    }
  }

  /* Content scrim — a soft dark-navy pool centred on the text column, sitting
     above the photo but below content (z-10). Lets the photo be genuinely
     vivid everywhere else while guaranteeing the badge/heading/description
     always sit over a dark, low-detail backdrop regardless of how bright or
     busy that part of the photo happens to be. Fixed to --techlo-navy (not
     the swappable brand colour) so it always agrees with the gradient. */
  .hero-content-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 65% 68% at 50% 45%,
      color-mix(in oklch, var(--techlo-navy) 78%, transparent) 0%,
      color-mix(in oklch, var(--techlo-navy) 45%, transparent) 60%,
      transparent 88%
    );
  }

  /* Left variant: a horizontal fade instead of a centred pool, for photos
     composed with the subject/detail toward the right and empty space on
     the left for copy (see scrimVariant prop). Strong enough on the far
     left for a heading to sit on, clear by mid-width so the photo's own
     colour and detail keep doing the work on the right rather than
     reading as a flat tinted panel. Tied to --gray-950 with a touch of the
     active brand hue mixed in (not the fixed techlo-navy) so this variant
     follows whichever colour theme is active, rather than being pinned to
     one hue regardless of theme. Also fades top and bottom slightly so the
     badge/CTA row aren't sitting on a hard-edged rectangle. Eased back
     ~28% from an earlier, heavier pass (80/62/25% washes) that read as a
     flat cinematic vignette rather than a premium, photo-forward tint —
     the founder photo should stay clearly visible through it. */
  .hero-content-scrim-left {
    background:
      linear-gradient(
        90deg,
        color-mix(in oklch, var(--gray-950) 58%, var(--color-brand-600) 18%) 0%,
        color-mix(in oklch, var(--gray-950) 45%, var(--color-brand-600) 16%) 32%,
        color-mix(in oklch, var(--gray-950) 18%, transparent) 55%,
        transparent 75%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--gray-950) 40%, transparent) 0%,
        transparent 22%,
        transparent 78%,
        color-mix(in oklch, var(--gray-950) 32%, transparent) 100%
      );
  }

  /* Below `md`, `background-size: cover` on a narrow, tall viewport crops the
     photo down to a much smaller slice than the desktop framing assumed, so
     there's no reliable "dark left / bright right" split left to fade across
     — the crop can land anywhere, including the photo's brightest area,
     under the same 90deg fade that reads fine on desktop. A near-uniform
     dark wash (still letting real photo colour and detail through) replaces
     the horizontal fade so heading/body text stay legible regardless of
     which part of the photo the crop happens to show. */
  @media (max-width: 767px) {
    .hero-content-scrim-left {
      background:
        linear-gradient(
          180deg,
          color-mix(in oklch, var(--gray-950) 58%, var(--color-brand-600) 10%) 0%,
          color-mix(in oklch, var(--gray-950) 53%, var(--color-brand-600) 8%) 55%,
          color-mix(in oklch, var(--gray-950) 44%, transparent) 100%
        );
    }
  }

  /* Desktop only: hide on landscape mobile (phones max out ~430px tall) */
  .scroll-indicator-wrapper {
    display: none;
  }

  @media (min-width: 1024px) and (min-height: 500px) {
    .scroll-indicator-wrapper {
      display: block;
    }
  }

  /* Fade in after the hero slide-up animation completes */
  .scroll-indicator {
    animation: si-fade-in 0.6s ease-out 1.4s backwards;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .scroll-indicator.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
  }

  @keyframes si-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* First chevron bounces, second follows with a slight delay */
  .scroll-indicator-chevron {
    animation: si-bounce 2s ease-in-out 2s infinite;
  }

  .scroll-indicator-chevron-2 {
    animation: si-bounce 2s ease-in-out 2.15s infinite;
  }

  @keyframes si-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }


  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator              { animation: none; opacity: 1; }
    .scroll-indicator-chevron,
    .scroll-indicator-chevron-2    { animation: none; }
  }
</style>

<script>
  // Scroll indicator: fade out once the user starts scrolling.
  // Stored on window so re-init across navigations replaces the previous
  // listener instead of stacking handlers.
  function initScrollIndicator() {
    const indicator = document.querySelector<HTMLElement>('.scroll-indicator');
    if (!indicator) return;

    const w = window as Window & { __scrollIndicatorHandler?: () => void };
    if (w.__scrollIndicatorHandler) {
      window.removeEventListener('scroll', w.__scrollIndicatorHandler);
    }

    function onScroll() {
      if (window.scrollY > 50) {
        indicator?.classList.add('is-hidden');
        window.removeEventListener('scroll', onScroll);
        delete w.__scrollIndicatorHandler;
      }
    }

    w.__scrollIndicatorHandler = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  initScrollIndicator();
</script>
