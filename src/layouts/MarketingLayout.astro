---
/**
 * MarketingLayout
 * Layout wrapper for marketing pages with floating capsule header
 * Uses Header shape="floating" for a distinctive visual identity
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { PageType } from '@/lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  /** Page flavour for the WebPage node (AboutPage, ContactPage, CollectionPage…). */
  pageType?: PageType;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  pageType,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  pageType={pageType}
>
  <Header
    slot="header"
    shape="bar"
    variant="solid"
    position="fixed"
    colorScheme="default"
    showCta={true}
  />

  <slot />

  <Footer slot="footer" layout="columns" background="techlo" />
</BaseLayout>
