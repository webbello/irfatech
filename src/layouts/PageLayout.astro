---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { SchemaNode, PageType, FaqItem } from '@/lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  /** Page flavour for the WebPage node (AboutPage, ContactPage, CollectionPage…). */
  pageType?: PageType;
  /** Breadcrumb trail — pass the same array to <Breadcrumbs> for the visible one. */
  breadcrumbs?: { label: string; href?: string }[];
  /** Q&As rendered on this page; adds the FAQPage type to the WebPage node. */
  faqs?: FaqItem[];
  /** `@id` of the entity this page is about. */
  aboutId?: string;
  /** `@id` of the page's main entity (an ItemList on a collection page). */
  mainEntityId?: string;
  /** CSS selectors a voice assistant may read aloud. */
  speakableSelectors?: string[];
  /** Extra graph nodes: Service, BlogPosting, ItemList … */
  extraSchemas?: SchemaNode[];
  /** Verified locale alternates for this page, forwarded to SEO for hreflang. */
  localeAlternates?: { locale: string; url: string }[];
  /**
   * Footer background. Defaults to `techlo` (fixed navy, same on every
   * page — see .footer-techlo in global.css), which doesn't need to zebra
   * against the page's last section since it no longer follows the
   * page's own light/dark background rhythm. `default`/`secondary`/
   * `invert` remain available for a page that wants the footer to blend
   * with its own theme instead.
   */
  footerBackground?: 'default' | 'secondary' | 'invert' | 'techlo';
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex,
  nofollow,
  showScrollProgress = false,
  eagerReveal = false,
  footerBackground = 'techlo',
  pageType,
  breadcrumbs,
  faqs,
  aboutId,
  mainEntityId,
  speakableSelectors,
  extraSchemas = [],
  localeAlternates,
} = Astro.props;

---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
  pageType={pageType}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  aboutId={aboutId}
  mainEntityId={mainEntityId}
  speakableSelectors={speakableSelectors}
  extraSchemas={extraSchemas}
  localeAlternates={localeAlternates}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showActiveState
    showCta={true}
    showScrollProgress={showScrollProgress}
  />

  <main class="min-h-screen pt-16">
    <slot />
  </main>

  <Footer slot="footer" layout="columns" background={footerBackground} />
</BaseLayout>
